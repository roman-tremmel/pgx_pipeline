// Minimal CI/smoke profile. Runs with -stub so no containers or data are needed:
//   nextflow run main.nf -profile test,singularity -stub
params {
    input        = "${projectDir}/assets/samplesheet.example.csv"
    genome_build = 'GRCh38'
    outdir       = 'results_test'
    max_cpus     = 2
    max_memory   = '6.GB'
    // keep Aldy off (license); exercise the rest
    run_aldy     = false
}
