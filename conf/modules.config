// Container images + publishDir per process. Pinned to the versions researched
// (Oct 2026). Images are pulled by Singularity from the quay.io / dockerhub URIs.

process {

    withName: 'PYPGX_.*' {
        container   = 'quay.io/biocontainers/pypgx:0.26.0--pyhdfd78af_0'
        label       = 'process_medium'
        publishDir  = [ path: { "${params.outdir}/pypgx/${meta.id}" }, mode: 'copy' ]
    }

    withName: 'ALDY' {
        container   = 'quay.io/biocontainers/aldy:4.8.3--pyhdfd78af_0'
        label       = 'process_medium'
        publishDir  = [ path: { "${params.outdir}/aldy/${meta.id}" }, mode: 'copy' ]
    }

    withName: 'CYRIUS' {
        container   = 'quay.io/biocontainers/cyrius:1.1.1--hdfd78af_0'
        label       = 'process_low'
        publishDir  = [ path: { "${params.outdir}/cyrius/${meta.id}" }, mode: 'copy' ]
    }

    withName: 'STELLARPGX' {
        container   = 'docker://twesigomwedavid/stellarpgx:latest'
        label       = 'process_high'
        publishDir  = [ path: { "${params.outdir}/stellarpgx/${meta.id}" }, mode: 'copy' ]
    }

    withName: 'OPTITYPE' {
        container   = 'quay.io/biocontainers/optitype:1.3.5--hdfd78af_2'
        label       = 'process_medium'
        publishDir  = [ path: { "${params.outdir}/hla/${meta.id}" }, mode: 'copy' ]
    }

    withName: 'DEEPVARIANT|BCFTOOLS_.*' {
        container   = 'quay.io/biocontainers/deepvariant:1.6.1--py310h0ca6d88_0'
        label       = 'process_high'
        publishDir  = [ path: { "${params.outdir}/variants/${meta.id}" }, mode: 'copy' ]
    }

    withName: 'PHARMCAT.*' {
        container   = 'docker://pgkb/pharmcat:3.4.0'
        label       = 'process_medium'
        publishDir  = [ path: { "${params.outdir}/pharmcat/${meta.id}" }, mode: 'copy' ]
    }

    withName: 'PARSE_.*|HARMONIZE|CONSENSUS' {
        container   = 'quay.io/biocontainers/pandas:2.2.1'
        label       = 'process_low'
        publishDir  = [ path: { "${params.outdir}/${task.process.tokenize(':')[-1].toLowerCase()}" }, mode: 'copy' ]
    }
}
