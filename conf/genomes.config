// Per-build parameters consumed by the caller modules.
// Each caller names the two reference builds differently; this map is the
// single place that translates params.genome_build into each tool's flag.

params {
    genomes {
        'GRCh38' {
            // tool-specific genome identifiers
            pypgx_assembly     = 'GRCh38'
            aldy_genome        = 'hg38'
            cyrius_genome      = '38'
            stellarpgx_build   = 'hg38'
            optitype_build     = 'hg38'
        }
        'GRCh37' {
            pypgx_assembly     = 'GRCh37'
            aldy_genome        = 'hg19'
            cyrius_genome      = '37'
            stellarpgx_build   = 'b37'
            optitype_build     = 'hg19'
        }
    }
}
