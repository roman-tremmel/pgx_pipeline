// ============================================================================
//  pgx_pipeline - consensus pharmacogenomics star-allele calling
// ============================================================================

manifest {
    name            = 'pgx_pipeline'
    author          = 'Roman'
    description     = 'Run multiple PGx star-allele callers and harmonize into a consensus call set'
    mainScript      = 'main.nf'
    nextflowVersion = '>=23.10.0'
    version         = '0.1.0'
}

params {
    // --- input / output ---
    input          = null          // samplesheet CSV (see assets/samplesheet_schema.json)
    outdir         = 'results'

    // --- reference ---
    genome_build   = 'GRCh38'      // 'GRCh38' | 'GRCh37'
    fasta          = null          // reference FASTA (required for CRAM and for variant calling)
    fasta_fai      = null

    // --- which callers to run ---
    run_pypgx      = true
    run_cyrius     = true          // CYP2D6 only, WGS only
    run_stellarpgx = true
    run_pharmcat   = true
    run_hla        = true          // OptiType (HLA-A/B) -> PharmCAT outside calls

    // Aldy is NON-COMMERCIAL / NON-DIAGNOSTIC only (Indiana University license).
    // It is OFF by default and will refuse to run unless the user asserts eligibility.
    run_aldy            = false
    aldy_license_ack    = false    // must be set true to acknowledge non-commercial research use

    // --- harmonization ---
    harmonization_table = "${projectDir}/assets/harmonization.tsv"
    // genes to attempt a consensus on (others are passed through per-tool only)
    consensus_genes     = 'CYP2D6,CYP2C19,CYP2C9,CYP2B6,CYP3A5,DPYD,TPMT,NUDT15,UGT1A1,SLCO1B1,GSTM1,GSTT1,NAT2'

    // --- resource genome maps (populated per build in conf/genomes.config) ---
    genomes        = [:]

    // --- max resources (overridden by executor configs) ---
    max_cpus       = 16
    max_memory     = '128.GB'
    max_time       = '48.h'

    help           = false
}

// ---------------------------------------------------------------------------
//  Profiles
// ---------------------------------------------------------------------------
profiles {
    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
        docker.enabled         = false
        // cache dir for pulled images; override with NXF_SINGULARITY_CACHEDIR
        singularity.cacheDir   = System.getenv('NXF_SINGULARITY_CACHEDIR') ?: "${launchDir}/singularity_cache"
    }
    docker {
        docker.enabled         = true
        singularity.enabled    = false
    }
    slurm {
        process.executor       = 'slurm'
    }
    test {
        includeConfig 'conf/test.config'
    }
}

includeConfig 'conf/base.config'
includeConfig 'conf/genomes.config'
includeConfig 'conf/modules.config'

// ---------------------------------------------------------------------------
//  Reporting
// ---------------------------------------------------------------------------
timeline { enabled = true; file = "${params.outdir}/pipeline_info/timeline.html"; overwrite = true }
report   { enabled = true; file = "${params.outdir}/pipeline_info/report.html";   overwrite = true }
trace    { enabled = true; file = "${params.outdir}/pipeline_info/trace.txt";     overwrite = true }
dag      { enabled = true; file = "${params.outdir}/pipeline_info/dag.html";      overwrite = true }
